              <calculation class='tableau' formula='IF [race_degradation_s_per_lap] &lt;= 0.046986061 THEN &quot;Low&quot;&#10;ELSEIF [race_degradation_s_per_lap] &lt;= 0.074543373 THEN &quot;Medium&quot;&#10;ELSE &quot;High&quot;&#10;END' />
