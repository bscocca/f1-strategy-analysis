    <worksheet name='Success by degradation'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Undercut success rate by race tyre degradation</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='degradation+ (f1_strategy)' name='federated.1oxifdq12p5voq12ajs110785qhv' />
          </datasources>
          <datasource-dependencies datasource='federated.1oxifdq12p5voq12ajs110785qhv'>
            <column caption='Degradation level' datatype='string' name='[Calculation_4964909706383360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [race_degradation_s_per_lap] &lt;= 0.046986061 THEN &quot;Low&quot;&#10;ELSEIF [race_degradation_s_per_lap] &lt;= 0.074513654 THEN &quot;Medium&quot;&#10;ELSE &quot;High&quot;&#10;END' />
            </column>
            <column caption='Success rate' datatype='real' default-format='p0%' name='[Calculation_4964909706539009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(INT([success]))' />
            </column>
            <column-instance column='[__tableau_internal_object_id__].[undercut!attempts_3490319D128F48A181E2BC35550D1718]' derivation='Count' name='[__tableau_internal_object_id__].[cnt:undercut!attempts_3490319D128F48A181E2BC35550D1718:qk]' pivot='key' type='quantitative' />
            <column caption='undercut_attempts' datatype='table' name='[__tableau_internal_object_id__].[undercut!attempts_3490319D128F48A181E2BC35550D1718]' role='measure' type='quantitative' />
